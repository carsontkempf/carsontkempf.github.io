(function() {
    const AUTH_URL = 'https://cloudprototype.org/api/auth';

    window.authService = {
        isAuthenticated: false,
        user: null,
        roles: [],
        login() { window.location.href = '/login/'; },
        logout() {
            const sdk = window._learnAuth;
            if (sdk) sdk.signOut().finally(() => { window.location.href = '/'; });
            else window.location.href = '/';
        },
        hasRole(required) {
            const list = Array.isArray(required) ? required : [required];
            const userRoles = (window.authService.roles || []).map(r => r.toLowerCase());
            return list.some(r => userRoles.includes(r.toLowerCase()));
        },
        getApiKey: async () => null
    };

    async function init() {
        try {
            if (typeof AuthSDK === 'undefined') throw new Error('AuthSDK not loaded');
            const auth = new AuthSDK({ tenantUrl: AUTH_URL });
            window._learnAuth = auth;

            const [session, roles] = await Promise.all([auth.getSession(), auth.getRoles()]);
            const user = session?.data?.user ?? null;

            window.authService.isAuthenticated = !!user;
            window.authService.user = user;
            window.authService.roles = roles;

            const loginBtn = document.getElementById('btn-login');
            const dashboardBtn = document.getElementById('btn-dashboard');
            const logoutBtn = document.getElementById('btn-logout');

            if (user) {
                const onDash = window.location.pathname === '/dashboard/' || window.location.pathname === '/dashboard';
                if (loginBtn) loginBtn.style.display = 'none';
                if (dashboardBtn) dashboardBtn.style.display = onDash ? 'none' : 'inline-block';
                if (logoutBtn) logoutBtn.style.display = onDash ? 'inline-block' : 'none';
            } else {
                if (loginBtn) loginBtn.style.display = 'inline-block';
                if (dashboardBtn) dashboardBtn.style.display = 'none';
                if (logoutBtn) logoutBtn.style.display = 'none';
            }

            if (loginBtn) loginBtn.addEventListener('click', e => { e.preventDefault(); window.authService.login(); });
            if (logoutBtn) logoutBtn.addEventListener('click', e => { e.preventDefault(); window.authService.logout(); });

        } catch (err) {
            console.error('[AUTH] Init failed:', err);
        } finally {
            document.dispatchEvent(new CustomEvent('authReady'));
        }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
})();
